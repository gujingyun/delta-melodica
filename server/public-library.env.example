# 复制到服务器 /etc/delta-melodica-public-library.env，限制为服务管理员可读。
MELODICA_PUBLIC_LIBRARY_ROOT=/usr/share/nginx/html/melodica
MELODICA_PUBLIC_LIBRARY_LOCK=/var/lib/delta-melodica-public-library/publish.lock
MELODICA_PUBLIC_LIBRARY_CATALOG_URL=https://aiygzn.top/melodica/songs.json
MELODICA_PUBLIC_LIBRARY_TOKEN=请替换为至少32个字符的随机令牌
